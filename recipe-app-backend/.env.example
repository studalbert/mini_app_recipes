# PostgreSQL
DATABASE_URL=postgresql+asyncpg://recipe_user:recipe_pass@localhost:5432/recipe_db

# Telegram
TELEGRAM_BOT_TOKEN=123456:AAExampleTokenReplaceMe

# Приложение
APP_SECRET_KEY=change-me-to-a-random-string
ENVIRONMENT=development

# Локальное хранилище фото. Файлы: {UPLOAD_DIR}/recipes/<id>/<uuid>.ext
# В БД хранится только относительный путь, раздаётся как /uploads/...
UPLOAD_DIR=./uploads
