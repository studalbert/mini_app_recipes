# Важные отличия от локальной разработки:
#  - хост БД: "postgres" (имя сервиса в docker-compose), а не "localhost"
#  - логин/пароль/имя БД должны совпадать с корневым .env (POSTGRES_USER и т.д.)
#  - UPLOAD_DIR: /app/uploads — путь ВНУТРИ контейнера backend (см. Dockerfile),
#    который смонтирован как volume "uploads" — тот же volume видит и nginx

DATABASE_URL=postgresql+asyncpg://recipe_user:придумай-длинный-случайный-пароль@postgres:5432/recipe_db
TELEGRAM_BOT_TOKEN=вставь-реальный-токен-от-BotFather
APP_SECRET_KEY=придумай-ещё-один-случайный-секрет
ENVIRONMENT=production
UPLOAD_DIR=/app/uploads
